{
	"height": 40,
	// custom
	"modules-left":		["hyprland/window"],
	"modules-center": 	["hyprland/workspaces"],
	"modules-right":	["custom/SongName", "image#prev", "image#PausePlay", "image#Next", "clock", "cpu", "disk", "memory", "temperature"],
	// maybe add wlr-taskbar and/or river(require config down bellow, so wasn't feasable at first)

	"margin": 10,
	"spacing": 5,
	"name": "hans",
	"mode": "dock",
	"reload_style_on_change": true,
	
	// configure modules
	"hyprland/window": {
		"format": "{}",
		"rewrite": {
			"(.*)Firefox": "🌎$1",
			"nvim (.*)": ">[$1]",
			"sudo(.*)": "⚠️$1⚠️",
			"(.*)Blender(.*)": "$1 Blender",
            "(.*)-(.*)": "$1"
		}
	},
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "一", "2": "二", "3": "三", "4": "四", "5": "五",
            "6": "六", "7": "七", "8": "八", "9": "九", "10": "十"
        },
        "disable-scroll": true,
        "persistent-workspaces": {
            "*": 10
        }
    },
    "custom/SongName": {
        "exec": "~/.config/waybar/scripts/songs.sh",
        "interval": 1,
        "escape": false,
        "format": "{}"
    },
    "image#prev": {
        "path": "/home/spinningdisk/.config/waybar/img/Prev.png",
        "size": 40,
        "on-click": "playerctl previous"
    },
    "image#PausePlay": {
        "path": "/home/spinningdisk/.config/waybar/img/PausePlay.png",
        "size": 40,
        "on-click": "playerctl play-pause"
    },
    "image#Next": {
        "path": "/home/spinningdisk/.config/waybar/img/Next.png",
        "size": 40,
        "on-click": "playerctl next"
    }
}
